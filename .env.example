# Obrigatória sempre que DJANGO_DEBUG != True — sem ela o processo se recusa a subir,
# em vez de cair numa chave embutida e conhecida.
DJANGO_SECRET_KEY=change-me-in-production
# Só para desenvolvimento local. O padrão do código é False (falha fechado): se esta
# variável não existir em produção, o servidor sobe seguro em vez de vazar traceback.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Opcional. Sem isto, usa SQLite local (efêmero no Render free tier).
# Para PostgreSQL: postgres://usuario:senha@host:5432/banco
# DATABASE_URL=

# Opcional. Limite de tamanho por PDF enviado, em bytes (padrão: 200 MB).
# MAX_PDF_BYTES=209715200

# Chave genérica — usada como fallback se as específicas abaixo não forem definidas
GEMINI_API_KEY=coloque-sua-chave-aqui

# Chaves por função (opcional, mas recomendado para distribuir cota)
# Se não definidas, todas as funções usam GEMINI_API_KEY
GEMINI_API_KEY_CONVERTER=
GEMINI_API_KEY_VALIDATOR=
GEMINI_API_KEY_RECONVERTER=
GEMINI_API_KEY_META=

GEMINI_MODEL=gemini-3.1-flash-lite
PDF_BLOCK_SIZE=5
